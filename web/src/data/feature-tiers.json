  "storage": {
    "basic_public": {
      "mode": "compact_public",
      "writerReady": true,
      "maxDatabaseBytes": 500000000,
      "blockedReason": null
    },
    "local_archive": {
      "mode": "full_archive",
      "writerReady": true,
      "maxDatabaseBytes": null,
      "blockedReason": null
    },
    "local_ai": {
      "mode": "full_archive",
      "writerReady": true,
      "maxDatabaseBytes": null,
      "blockedReason": null
    },
    "cloud_ai": {
