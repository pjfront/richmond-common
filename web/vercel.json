{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/assert-preview-env.mjs && npm run build",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in heartbeat|automation/*|automation-*) exit 0 ;; *) exit 1 ;; esac",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "heartbeat": false,
      "automation/**": false,
      "automation-*": false
    }
  }
}
