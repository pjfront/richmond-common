# Richmond Transparency Project — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# --- Required for Phase 1 ---

# DeepSeek API key (primary chat/extraction provider; never falls back to another key)
DEEPSEEK_API_KEY=sk-...

# Optional Kimi routes. One MOONSHOT_API_KEY enables direct Kimi K3 challenger
# and K2.6 vision calls. AI_GATEWAY_API_KEY is optional for text-only challenger
# experiments; Gateway vision is quarantined until its image cost can be
# estimated conservatively. Neither provider is a silent fallback.
MOONSHOT_API_KEY=
AI_GATEWAY_API_KEY=

# Cost-aware logical model tiers. Values are validated against a narrow allowlist
# at process startup; unknown IDs fail closed before any network request.
RICHMOND_LLM_ROUTINE_MODEL=deepseek-v4-flash
RICHMOND_LLM_QUALITY_MODEL=deepseek-v4-pro
RICHMOND_LLM_REASONING_MODEL=deepseek-v4-pro
RICHMOND_LLM_CHALLENGER_MODEL=kimi-k3
RICHMOND_LLM_VISION_MODEL=kimi-k2.6

# LLM spending rails. The monthly ledger must be readable before a paid call.
RICHMOND_API_BUDGET_LOCK=false
RICHMOND_API_MONTHLY_CAP_USD=5.00
RICHMOND_EVENT_BUDGET_USD=
RICHMOND_EVENT_TYPE=

# OpenAI API key. Production embeddings use text-embedding-3-small. Chat is
# available only through the explicit gpt-5.6-luna benchmark route; it is not a
# fallback or a default tier. Pipeline + frontend gracefully
# fall back to FTS-only when this optional key is unset.
# Set in Vercel prod env (query-time embedding) AND GH Actions secrets
# (incremental backfill cron) for end-to-end hybrid search.
OPENAI_API_KEY=sk-proj-...

# --- Required for Phase 2 (Supabase + Frontend) ---

# Supabase project URL (Settings → General → Reference ID, or API Keys page)
# Format: https://xxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon key (API Keys page → "Publishable key" starting with sb_publishable_...)
SUPABASE_ANON_KEY=sb_publishable_...

# PostgreSQL connection string (Database → Connection string → URI tab)
# This is used by the Python pipeline (db.py) to load data into Supabase
# Replace [YOUR-PASSWORD] with the password you set when creating the project
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Supabase CLI access token (for running migrations via CLI)
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# --- Optional for Phase 1, required later ---

# Socrata API (Transparent Richmond open data portal)
# Get a free app token at https://www.transparentrichmond.org/
SOCRATA_APP_TOKEN=
SOCRATA_DOMAIN=www.transparentrichmond.org

# Email (for submitting public comments to City Clerk)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
COMMENT_FROM_EMAIL=

# OpenCorporates API (business entity resolution — apply at opencorporates.com/api_accounts/new)
OPENCORPORATES_API_TOKEN=
OPENCORPORATES_DAILY_LIMIT=50
OPENCORPORATES_MONTHLY_LIMIT=200

# Operator authentication (server-only — never use NEXT_PUBLIC_* prefix)
# OPERATOR_PASSWORD: the password the operator types at /operator/login
# IRON_SESSION_PASSWORD: must be at least 32 chars; used to seal the session cookie
OPERATOR_PASSWORD=change-me
IRON_SESSION_PASSWORD=change-me-to-at-least-32-random-characters-please

# Rate limiting is Postgres-backed (migration 106 rate_limit_buckets).
# No additional credentials needed — client keys use IRON_SESSION_PASSWORD for
# daily HMAC pseudonyms and database writes use SUPABASE_SERVICE_ROLE_KEY below.

# Supabase service role key (for server-side API routes with elevated RLS access)
# Settings → API Keys → service_role (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (for email delivery — welcome emails, weekly digest)
# Sign up at https://resend.com and verify richmondcommons.org domain
RESEND_API_KEY=re_...

# Operator-approved test recipient for canary-only subscriber emails.
# Configure as a server-side Vercel environment variable; never NEXT_PUBLIC_.
SUBSCRIBER_CANARY_EMAIL=operator-canary@example.com

# Site URL (used for unsubscribe links in emails)
NEXT_PUBLIC_SITE_URL=https://richmondcommons.org

# --- Production deploy (web/scripts/deploy-prod.sh) ---

# Vercel CLI project linkage. Public IDs (not secrets) — required for
# bash web/scripts/deploy-prod.sh to know which Vercel project + team
# to deploy to. Auth itself lives in %APPDATA%\com.vercel.cli\auth.json
# (per-user, set up once via `vercel login`).
#
# How to get the values:
#   1. vercel login                       # one-time, opens browser
#   2. mkdir tmp && cd tmp
#   3. vercel link --yes --scope <team-slug> --project rtp
#   4. cat .vercel/project.json           # copy projectId + orgId
#   5. cd .. && rm -rf tmp
#
# Or open https://vercel.com/<team>/rtp/settings and copy from there.
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxx
